[nat_policy_default_values]
# NAT policy settings
stun_server=
nat_address=
upnp=0
ice=0
turn=0
turn_username=
turn_password=

[codec_0]
# Audio codec configuration - G711 mu-law (PCMU)
mime=PCMU
rate=8000
channels=1
enabled=1

[codec_1]
# Audio codec - G711 a-law (PCMA)
mime=PCMA
rate=8000
channels=1
enabled=1

[codec_2]
# Audio codec - G722
mime=G722
rate=8000
channels=1
enabled=1

[codec_3]
# Audio codec - Opus (if available)
mime=opus
rate=48000
channels=2
enabled=1

[codec_4]
# Audio codec - telephone-event for DTMF
mime=telephone-event
rate=8000
channels=1
enabled=1